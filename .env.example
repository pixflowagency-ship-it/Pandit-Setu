# ==============================================================================
# Sarvmangal / Pandit Setu Backend — Environment Configuration Template
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database (PostgreSQL with PostGIS extension enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poojapaath_db

# Redis (Caching, Temple geohash, Socket.io adapter, and OTP)
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=4h
OTP_EXPIRY_SECONDS=300

# Admin Provisioning (Used by 'npm run db:provision-admin')
# Set strong, unique credentials; never commit actual credentials to Git
ADMIN_INITIAL_EMAIL=admin@sarvmangal.app
ADMIN_INITIAL_PASSWORD=change_to_a_secure_password_min_12_chars
FORCE_ADMIN_PASSWORD_RESET=false

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Video Calling (Agora WebRTC)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Location & Maps (Google Places API for nearby temples)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Push Notifications (Firebase Admin Cloud Messaging)
# Provide either Base64 encoded JSON string or path to JSON service account file:
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=
