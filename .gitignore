# ==============================================================================
# SARV MANGAL — Root .gitignore
# ==============================================================================

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
secrets/
credentials/

# Node.js
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.nyc_output/

# Flutter / Dart
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
flutter_*.log

# IDE & Operating System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & Temporary Files
*.log
tmp/
temp/
scratch/

# Local Databases & Backups
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# Temporary Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Local Media Storage & User Documents
storage/
**/storage/
